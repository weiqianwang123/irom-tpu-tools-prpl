[Unit]
Description=Audit PRPL shared Cloud Storage usage by user
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/google-cloud-sdk/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/tpu admin storage --refresh --output=%h/.local/state/irom-tpu-tools/storage-audit.json

